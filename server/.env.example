# Example environment variables for server
# Copy this to .env and fill in secure values (DO NOT commit .env)

PORT=5000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-strong-random-secret
NODE_ENV=development
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_DAYS=30
REFRESH_TOKEN_BINDING_STRICT=false
SENTRY_DSN=

# Database connection settings (example)
DB_SERVER=your-db-server
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_PORT=1433
DB_DRIVER=tedious

# Admin credentials fallback (only when Admins table is not configured)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Cloudinary (if used)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
